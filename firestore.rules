rules_version = '2';

// Chaque personne ne lit et n'écrit que ses propres relevés.
// Les comptes sont créés à la main dans la console Firebase :
// aucune inscription depuis l'application.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/readings/{readingId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
