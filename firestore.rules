rules_version = '2';

// Chaque personne ne lit et n'écrit que ses propres relevés.
// Les comptes sont créés à la main dans la console Firebase :
// aucune inscription depuis l'application.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/readings/{readingId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Poids du jour : un document par date, réservé au propriétaire.
    match /users/{uid}/weights/{date} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Lien du médecin : lecture publique d'un instantané identifié par un jeton
    // aléatoire (`?d=…`). Le document ne contient que les relevés copiés au moment
    // du partage, pas d'accès à la collection de l'utilisateur.
    // Seul le propriétaire peut créer, mettre à jour ou révoquer son instantané.
    match /shares/{token} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }
  }
}
